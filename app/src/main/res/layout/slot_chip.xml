<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chipRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/chip_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal">

    <View
        android:id="@+id/chipBar"
        android:layout_width="5dp"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textColor="@color/bg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:fadingEdgeLength="14dp"
                android:marqueeRepeatLimit="marquee_forever"
                android:requiresFadingEdge="horizontal"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/chipState"
                style="@style/Label"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chipPath"
            style="@style/Label"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/chipLyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/lyric_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/lyric1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/lyric2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/lyric3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/chipSeek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:max="1000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- 固定宽高：时间每秒变化时只重绘不重排，避免打断上面名字的跑马灯 -->
            <TextView android:id="@+id/chipPos" style="@style/Label" android:layout_width="64dp" android:layout_height="16dp" android:singleLine="true" android:textSize="11sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/chipDur" style="@style/Label" android:layout_width="64dp" android:layout_height="16dp" android:gravity="end" android:singleLine="true" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
